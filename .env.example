APP_ENV=dev
APP_SECRET=

DEFAULT_URI=http://localhost

DATABASE_URL="sqlite:///%kernel.project_dir%/var/database/%kernel.environment%.db"

CORS_ALLOW_ORIGIN='^https?://(localhost|127\.0\.0\.1)(:[0-9]+)?$'

RATE_LIMITING_ENABLED=true

# Behind a reverse proxy (see README "Running behind a proxy")
TRUSTED_PROXIES=
CLIENT_IP_HEADER=
